# === Lido pelo CLI do Supabase (env() do supabase/config.toml) ===
# Copie para .env na raiz (gitignored) e preencha.

# --- Google OAuth (login "Continuar com Google" da loja) ---
# Client web em https://console.cloud.google.com/auth/clients
# Authorized redirect URI (local): http://127.0.0.1:54321/auth/v1/callback
# Enquanto o consent screen estiver em "Testing", só e-mails cadastrados em
# Audience → Test users conseguem logar.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Resend — DOIS usos, uma chave ---
#   1. SMTP dos e-mails de AUTH (código de login e reset de senha): quem envia é o
#      GoTrue, via [auth.email.smtp] do config.toml.
#   2. API HTTP dos e-mails TRANSACIONAIS (pedido recebido / pago / enviado):
#      quem envia é a edge function `send-email`, via POST https://api.resend.com/emails.
#      Por isso a chave também aparece em [edge_runtime.secrets].
# API key em https://resend.com/api-keys.
#
# DOIS remetentes, um domínio (`send.nanita.com.br`, verificado no Resend em 2026-08-02):
#   auth         → `admin_email` em [auth.email.smtp] do config.toml → acesso@send.nanita.com.br
#                  Endereço NU e VERSIONADO — não está neste arquivo. O nome de exibição
#                  vem do `sender_name` ao lado.
#   transacional → RESEND_FROM abaixo                                → loja@send.nanita.com.br
# **RESEND_FROM não afeta o auth.** Trocar só ele deixa o login mandando do endereço antigo.
#
# ATENÇÃO ao remetente compartilhado: `onboarding@resend.dev` funciona sem domínio
# verificado, mas **só entrega para o e-mail dono da conta Resend** — qualquer outro
# destinatário volta 403 `validation_error` (e, no SMTP do auth, 550). Se você estiver
# com uma chave sem domínio verificado, use RESEND_DEV_REDIRECT_TO abaixo — mas note que
# ela cobre só os transacionais; o GoTrue não tem válvula equivalente.
RESEND_API_KEY=

# Remetente dos transacionais. Formato RFC 5322 — `Nome <e@dominio>` ou só `e@dominio`
# (display name com vírgula precisa de aspas). Malformado = 422 em TODOS os e-mails, ou
# seja apagão silencioso; a function valida o formato antes de tentar enviar.
# Vazio ⇒ default do código: Nanita <onboarding@resend.dev>
# Valor em uso: "Nanita Store<loja@send.nanita.com.br>"
RESEND_FROM=

# Origem DA LOJA — NÃO a do Supabase. É a base do link "Acompanhar em Minha conta"
# dos e-mails. Dev: http://localhost:8080 · Produção: https://<dominio-da-loja>
# (Toda outra env de URL deste arquivo aponta para o Supabase; esta é a exceção.)
STORE_PUBLIC_URL=http://localhost:8080

# SÓ DEV: redireciona todo destinatário dos TRANSACIONAIS para este endereço e prefixa o
# assunto com o real (`[dev → cliente@x.com] ...`). Com o domínio verificado virou OPT-IN:
# só serve para quem estiver com uma chave sem domínio. Não cobre os e-mails de auth.
# **Deixar VAZIA** no dia a dia e em produção — preenchida, nenhum cliente recebe.
RESEND_DEV_REDIRECT_TO=

# === Secrets das edge functions (Supabase) ===
# Local: são lidos DESTE arquivo, via [edge_runtime.secrets] do supabase/config.toml
#   (env(...) versionado, igual ao Google OAuth e ao Resend acima).
#   Aplicar mudança de valor: supabase stop && supabase start.
# Projeto hospedado: este arquivo não é lido — setar com
#   supabase secrets set MERCADO_PAGO_ACCESS_TOKEN=... MERCADO_PAGO_WEBHOOK_SECRET=...
#   supabase secrets set RESEND_API_KEY=... RESEND_FROM=... STORE_PUBLIC_URL=...
#   (RESEND_DEV_REDIRECT_TO NÃO vai para produção.)

# Access token do Mercado Pago. ATENÇÃO: o prefixo NÃO diz o modo.
#   `TEST-...`     → credenciais de teste da aplicação;
#   `APP_USR-...`  → produção **ou** um usuário de teste (sandbox). Os dois casos são APP_USR-.
# Para saber de fato em que modo está, pergunte ao MP (não vaza o token no stdout):
#   TOKEN=$(grep '^MERCADO_PAGO_ACCESS_TOKEN=' .env | cut -d= -f2-)
#   curl -s https://api.mercadopago.com/users/me -H "Authorization: Bearer $TOKEN"
# `tags` com `test_user` (e nickname `TESTUSER...`) = sandbox. Sem isso = dinheiro real.
# Painel MP → Suas integrações → <sua aplicação> → Credenciais de teste / Contas de teste.
MERCADO_PAGO_ACCESS_TOKEN=
# Secret de assinatura de webhook — valida o header x-signature (HMAC-SHA256 do manifest).
# Painel MP → Suas integrações → <sua aplicação> → Webhooks → "Assinatura secreta"
# (aparece ao salvar a URL de notificação; produção e teste têm segredos distintos).
MERCADO_PAGO_WEBHOOK_SECRET=
# Precificação estrita por variação (feature 07 / PST-09). OPCIONAL — o default é `true`.
#
# Ligada (padrão), um item cujo preço não é resolvível — variação inexistente, de outro produto, ou
# sem preço — devolve 422 e NÃO cobra. Desligada (`false`), o item cai em `products.base_price` com
# log `variant_pricing_lenient`.
#
# Quando desligar: SÓ durante um deploy em que a edge function sobe ANTES do bundle da loja, porque
# abas já abertas seguem mandando item sem `variant_id`. Religue assim que o bundle estiver no ar.
# Deixá-la desligada em regime é cobrar `base_price` por uma variação de R$ 18,40, em silêncio.
# STRICT_VARIANT_PRICING=true
# --- Webhook: a URL fica NO PAINEL do MP, não aqui ---
# A API de Orders valida o corpo por schema fechado e RECUSA `notification_url` como propriedade
# não suportada (HTTP 400 `unsupported_properties`) — diferente da API de Pagamentos, onde ela era
# legítima na raiz. Portanto o destino da notificação é configurado só em
#   Painel MP → Suas integrações → <aplicação> → Webhooks.
# Em dev, aponte para um túnel (`cloudflared tunnel --url http://127.0.0.1:54321`) e cadastre a URL
# `https://<subdominio>.trycloudflare.com/functions/v1/mercado-pago?action=webhook` lá.
# Quick tunnel é efêmero: cada restart gera subdomínio novo e exige repastar no painel.

# === Envs dos apps (Vite) ===
# Ficam no .env de cada app (apps/store/.env, apps/backoffice/.env) — ver .env.example de cada um.
# A loja usa também VITE_MP_PUBLIC_KEY (public key do Mercado Pago, par do access token acima).

# === Auth: o que é código vs. o que é painel ===
# Local: tudo versionado em supabase/config.toml + supabase/templates/*.html.
#   Aplicar mudanças: supabase stop && supabase start (db reset NÃO recarrega auth).
# Projeto hospedado: replicar no painel Supabase →
#   1. Authentication → Providers → Google: client ID/secret (client web separado,
#      com o callback do projeto: https://<ref>.supabase.co/auth/v1/callback).
#   2. Authentication → URL Configuration → Redirect URLs: as origens de produção.
#   3. Authentication → SMTP Settings: smtp.resend.com:465, user "resend",
#      pass = RESEND_API_KEY, Sender email = acesso@send.nanita.com.br (o MESMO
#      `admin_email` do config.toml), Sender name = Nanita.
#   4. Authentication → Email Templates: colar magic_link.html, confirmation.html
#      e recovery.html de supabase/templates/ (todos usam {{ .Token }}).
