{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "ignoreCommand": "npx --yes turbo-ignore @estrelinha/store --fallback=HEAD^",
  "trailingSlash": false,
  "redirects": [
    { "source": "/produto/:slug", "destination": "/produtos/:slug", "statusCode": 301 },
    { "source": "/colecao/:slug", "destination": "/:slug", "statusCode": 301 },
    { "source": "/categoria/:slug", "destination": "/:slug", "statusCode": 301 },
    {
      "source": "/como-enviar-o-material",
      "destination": "/como-enviar-seu-material-de-dna",
      "statusCode": 301
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
