# Copie para apps/store/.env (gitignored) e preencha.
# O client de @nanapin/supabase LANÇA ERRO se VITE_SUPABASE_URL ou
# VITE_SUPABASE_PUBLISHABLE_KEY faltarem — não há fallback silencioso.

# --- Supabase ---
# Dev: a instância local deste repositório, na faixa 54341-54349
# (supabase/config.toml, project_id "uma-estrelinha-store").
#   VITE_SUPABASE_URL=http://127.0.0.1:54341
#   VITE_SUPABASE_PUBLISHABLE_KEY: sai do `supabase start` / `supabase status`
#     (campo PUBLISHABLE_KEY). A chave local é fixa e não é segredo.
# PENDENTE — produção (C-08): projeto hospedado ainda não criado.
#   Passo de troca: Supabase → Project Settings → API →
#     Project URL          -> VITE_SUPABASE_URL
#     Publishable/anon key -> VITE_SUPABASE_PUBLISHABLE_KEY
#   Depois: replicar no ambiente da Vercel do app `store`.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Identificador do projeto local. Informativo — nenhum código o lê.
VITE_SUPABASE_PROJECT_ID=uma-estrelinha-store

# --- Mercado Pago (Bricks, lado do navegador) ---
# Public key, PAR do MERCADO_PAGO_ACCESS_TOKEN do .env da RAIZ: as duas precisam
# ser do mesmo modo. Misturar sandbox com produção falha só na hora de pagar.
#   TEST-...    -> credenciais de teste da aplicação
#   APP_USR-... -> produção OU usuário de teste (sandbox) — o prefixo não diz qual
# PENDENTE — produção (C-08): a conta MP definitiva da loja ainda não foi entregue.
#   Passo de troca: Painel MP → Suas integrações → <aplicação> → Credenciais de
#   produção → Public key. Trocar junto com o access token da raiz, nunca só um.
VITE_MP_PUBLIC_KEY=
