# Hoist all deps to the workspace root node_modules (npm-like layout).
# Simplifies the monorepo migration: apps and packages resolve shared
# externals (react, radix, etc.) without declaring each one per workspace.
node-linker=hoisted
# Do not re-run `pnpm install` automatically before scripts (turbo/vite).
verify-deps-before-run=false
# Ignored native build scripts are a warning, not a fatal error.
strict-dep-builds=false
